# CarePilot 环境变量示例
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=deepseek-chat
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 仅 evaluation/cli.py 读取：判官专用模型（与答题模型分离，规避自评偏差）
JUDGE_MODEL=deepseek-reasoner

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me
# docker compose 内部地址（容器间通信）
REDIS_URL=redis://:carepilot123@redis:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 降级用本地路径（ChromaDB 服务不可用时自动切换）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
